# Public URL of the site, no trailing slash. Used for Stripe return URLs,
# canonical URLs, the sitemap and social images.
NEXT_PUBLIC_SITE_URL=

# --- Stripe (server only) ----------------------------------------------------
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional. Comma-separated Stripe Shipping Rate IDs (shr_...) from the Dashboard.
# Without any, Checkout collects an address but adds no shipping charge.
STRIPE_SHIPPING_RATE_IDS=
# Optional. Countries Checkout ships to (ISO codes). Defaults to US.
CHECKOUT_SHIPPING_COUNTRIES=US
# Set to true once Stripe Tax is configured in the Dashboard.
STRIPE_AUTOMATIC_TAX=

# --- Email via Resend --------------------------------------------------------
RESEND_API_KEY=
# Required. No sender is hardcoded in source; forms and order alerts return a
# graceful "not configured" error until this is set.
CONTACT_FROM_EMAIL=
# Comma-separated inboxes that receive order alerts and form submissions.
CONTACT_RECEIVER_EMAILS=

# --- Bot protection via Cloudflare Turnstile (optional) ----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Defaults to the hostname of NEXT_PUBLIC_SITE_URL.
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA_ID=
